[Unit]
Description=Top-level domains directory (http://100.124.28.119:8977); data refreshed by Windmill f/upcoming_tlds/daily_update
After=network-online.target

[Service]
WorkingDirectory=/home/vlad/upcoming-tlds
Environment=HOST=100.124.28.119 PORT=8977
ExecStart=/usr/bin/python3 -u server.py
